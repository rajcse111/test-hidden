# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/interview_assistant.db
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2:3b
WHISPER_MODEL=base
LOCAL_ONLY=false
LOG_LEVEL=INFO
TRANSCRIPT_PERSISTENCE=false
TRANSCRIPT_CONTEXT_SEGMENTS=60
INTERVIEW_AUTH_TOKEN=
PRELOAD_WHISPER_MODEL=false
STT_SILENCE_FRAMES=2
STT_PARTIAL_TRIGGER_SECONDS=2.0
STT_PARTIAL_COOLDOWN_SECONDS=1.5

# RAG — requires local-rag/ dependencies installed and Ollama running
RAG_ENABLED=true
RAG_CHROMA_PATH=./local-rag/storage
CHROMA_PATH=./local-rag/storage
RAG_COLLECTION_NAME=documents
RAG_EMBED_MODEL=nomic-embed-text
RAG_LLM_MODEL=llama3.2:3b
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=1.4
RAG_TEMPERATURE=0.2

# Desktop
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/interview
VITE_BACKEND_TOKEN=
