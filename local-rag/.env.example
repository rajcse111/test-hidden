# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL of your local Ollama server.  Default is localhost:11434.
OLLAMA_HOST=http://localhost:11434

# ── Models ────────────────────────────────────────────────────────────────────
# LLM used for answer generation.
# On a 16 GB RAM laptop with no GPU, llama3.2:3b is faster; llama3.1:8b is smarter.
LLM_MODEL=llama3.1:8b

# Embedding model.  Must be the SAME model used at both index time and query time.
EMBED_MODEL=nomic-embed-text

# ── Vector store ──────────────────────────────────────────────────────────────
# Directory where ChromaDB will persist its data.  Created automatically.
CHROMA_PATH=./storage

# Collection name within ChromaDB.  One collection = one knowledge base.
COLLECTION_NAME=documents

# ── Chunking ──────────────────────────────────────────────────────────────────
# Target character count per chunk (~800 chars ≈ ~200 tokens).
# Larger = more context per chunk; smaller = more precise retrieval.
CHUNK_SIZE=800

# Characters of overlap between consecutive chunks.
# Prevents information loss at chunk boundaries.
CHUNK_OVERLAP=120

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks to retrieve per query.
TOP_K=4

# Cosine distance threshold (0=identical, 2=opposite).
# Chunks with distance > this value are dropped as irrelevant.
RETRIEVAL_DISTANCE_THRESHOLD=1.4

# ── Generation ────────────────────────────────────────────────────────────────
# Low temperature keeps answers grounded; higher values increase creativity.
# Recommended range: 0.1–0.3 for factual Q&A.
TEMPERATURE=0.2
